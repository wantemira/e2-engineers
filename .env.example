# Published on 127.0.0.1 by Docker Compose.
BUDDY_PORT=5173
BUDDY_TRAINING_PORT=8081

# demo never calls a model. Set live only after configuring the API below.
BUDDY_MODE=demo
LLM_PROVIDER=openai-compatible
# API base URL ending in /v1 (not /chat/completions).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=20s
